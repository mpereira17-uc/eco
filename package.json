{
  "name": "eco",
  "version": "1.0.0",
  "description": "Eco: un juego de ecolocalización en cuevas procedurales",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "node --test tests/*.test.js",
    "start": "node tools/serve.js",
    "build:web": "node tools/build-web.mjs",
    "build:exe": "bash launcher/build.sh",
    "package": "bash tools/package.sh",
    "build:artifact": "node tools/build-web.mjs && node tools/build-artifact.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.24.2"
  }
}
